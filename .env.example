# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.5

# Agent runtime
AGENT_NAME=Agent OS
AGENT_MODE=policy-autonomous
AGENT_BASE_URL=http://127.0.0.1:8080
WORKSPACE_DIR=/workspace
AUDIT_DB=/data/agent_os.db
JOB_POLL_SECONDS=5
MAX_AGENT_STEPS=8

# Portainer
PORTAINER_URL=https://portainer.your-tailnet.ts.net
PORTAINER_API_KEY=replace_me
PORTAINER_TIMEOUT_SECONDS=30

# Optional default change ticket for pre-approved maintenance windows
DEFAULT_CHANGE_TICKET=

# Optional shared secret for API clients. Leave empty for local-only MVP.
AGENT_API_TOKEN=
